filters:
  and:
    - 'file.inFolder("knowledge")'
    - 'file.ext == "md"'

properties:
  summary:
    displayName: 一句话
  type:
    displayName: 类型
  file.mtime:
    displayName: 更新

views:
  - type: table
    name: 全部
    order:
      - file.name
      - summary
      - type
      - file.mtime

  - type: table
    name: 按类型
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - summary
      - file.mtime

  - type: table
    name: 主题
    filters:
      and:
        - 'file.folder == "knowledge/topics"'
    order:
      - file.name
      - summary
      - file.mtime